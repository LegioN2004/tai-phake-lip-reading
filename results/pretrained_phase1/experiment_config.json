{
  "experiment_phase": "Phase 1: Pretrained CNN + BiLSTM Baselines",
  "project_name": "Tai Phake Lip-Reading Visual Speech Recognition",
  "input_dimensions": [
    64,
    128,
    3
  ],
  "sequence_length": 30,
  "normalization": "pixel / 255.0 to [0, 1]",
  "augmentation": "OFF",
  "num_speakers": 30,
  "speaker_split": {
    "train_speakers": 20,
    "val_speakers": 4,
    "test_speakers": 6,
    "seed": 42
  },
  "training_hyperparameters": {
    "optimizer": "Adam",
    "learning_rate": 0.0001,
    "loss": "sparse_categorical_crossentropy",
    "batch_size": 16,
    "max_epochs": 80,
    "patience": 15,
    "bilstm_units": 64,
    "dropout_rate": 0.3
  },
  "models_evaluated": [
    "MobileNetV2 + BiLSTM",
    "EfficientNetB0 + BiLSTM",
    "ResNet50 + BiLSTM"
  ]
}