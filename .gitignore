# ==============================================================================
# Tai Phake Visual Speech Recognition (VSR) - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dataset & Media Files (Local raw/processed data - NEVER push heavy datasets)
# ------------------------------------------------------------------------------
# Video formats
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.flv
*.wmv
*.m4v

# Audio formats
*.wav
*.mp3
*.aac
*.flac
*.m4a
*.jpg

# Frame and image files in data directories
data/*
!data/metadata.csv
!data/manifest.csv
!data/extraction_report.csv
!data/README.md
!data/**/
!data/**/.gitkeep

# Ignore all cropped and augmented datasets
data/trimmed/
data/processed/
data/digit/
data/digit_folder_initial/
data/digit_vid_frames/
data/cropped_lips_dataset/
data/cropped_lips_dataset_*/
data/dlib_cropped_lips_dataset/
data/augmented_100spk_dataset_d/

# ------------------------------------------------------------------------------
# 2. Model Weights & Heavy Checkpoints (Git LFS or local storage only)
# ------------------------------------------------------------------------------
*.h5
*.keras
*.pth
*.pt
*.ckpt
*.onnx
*.tflite
*.pb
*.weights
models/*
!models/.gitkeep
results/**/best_model.keras
results/**/checkpoint*
results/**/*.keras
results/**/*.h5
results/**/*.pth
results/**/*.pt

# ------------------------------------------------------------------------------
# 3. Python Cache, Build, & Virtual Environments (UV / Python 3.12)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 4. Jupyter Notebook Artifacts
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ------------------------------------------------------------------------------
# 5. OS and IDE Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary scratch and experiment work logs
scratch/
